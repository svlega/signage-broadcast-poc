# Laravel backend origin (the display-schedule / heartbeat API).
# :8000 for `php artisan serve` (native); :8090 if the backend is
# running via `docker compose up` instead — the two setups use
# different host ports, and this is not auto-detected. A wrong value
# here fails silently from the player's point of view: it just falls
# back to whatever's in its offline cache, no visible error.
VITE_API_BASE_URL=http://localhost:8000

# Must match the backend's REVERB_APP_KEY / REVERB_HOST / REVERB_PORT
# in backend/.env — see App\Events\ScheduleUpdated.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=6001
VITE_REVERB_SCHEME=http

VITE_APP_VERSION=1.0.0
