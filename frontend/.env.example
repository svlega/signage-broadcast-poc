# Laravel backend origin (the display-schedule / heartbeat API). :8090
# either way — Docker's web container and a bare-metal
# `php artisan serve --port=8090` both use the same port (see
# backend/.env.example's APP_URL comment), so this value doesn't need to
# change depending on which one happens to be running. A wrong value
# here still fails silently from the player's point of view — it just
# falls back to whatever's in its offline cache, no visible error — so
# it's worth actually confirming this matches before assuming a bug.
VITE_API_BASE_URL=http://localhost:8090

# Must match the backend's REVERB_APP_KEY / REVERB_HOST / REVERB_PORT
# in backend/.env — see App\Events\ScheduleUpdated.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=6001
VITE_REVERB_SCHEME=http

VITE_APP_VERSION=1.0.0
