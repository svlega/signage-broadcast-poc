# Laravel backend origin (the display-schedule / heartbeat API).
VITE_API_BASE_URL=http://localhost:8000

# Must match the backend's REVERB_APP_KEY / REVERB_HOST / REVERB_PORT
# in backend/.env — see App\Events\ScheduleUpdated.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=6001
VITE_REVERB_SCHEME=http

VITE_APP_VERSION=1.0.0
