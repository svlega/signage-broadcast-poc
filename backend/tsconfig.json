{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["resources/js/admin/**/*", "resources/js/admin/**/*.vue"],
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@admin/*": ["./resources/js/admin/*"]
    },
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "noEmit": true
  }
}
