# Copy to backend/.env.docker before running `docker compose up`.
# Distinct from backend/.env (used for `php artisan serve` on bare
# metal) because the two setups disagree on nearly every hostname:
# Docker's app/queue/reverb containers reach MySQL and Redis via their
# service names on the compose network, not 127.0.0.1.

APP_NAME="Signage Broadcast Engine"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8090

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=signage
DB_USERNAME=signage
DB_PASSWORD=signage

SESSION_DRIVER=database
SESSION_LIFETIME=120

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# The queue/app containers reach Reverb over the compose network by
# service name to *publish* events. This is deliberately different from
# the browser-facing VITE_REVERB_HOST the frontend/admin builds use
# (localhost, or wherever docker-compose actually publishes 6001 to) —
# server-to-server and browser-to-server are two different audiences
# reaching the same Reverb process by two different routes.
REVERB_APP_ID=signage-poc
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=6001
REVERB_SCHEME=http
REVERB_SCALING_ENABLED=true

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/admin/integrations/google/callback"
