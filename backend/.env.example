APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# :8090, not the Laravel-default :8000 — Docker's `web` container
# publishes 8090, and this file's DB/REDIS/REVERB settings below assume
# you're pointed at Docker's mysql/redis (see docker-compose.yml's
# published ports on those two services). Whichever one is actually
# *serving* HTTP — Docker's web container, or a bare-metal
# `php artisan serve --port=8090` — this stays the same either way, so
# there's one URL to remember and one Google OAuth redirect URI to
# register, not two.
APP_URL=http://localhost:8090

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# 127.0.0.1, not the service name `mysql` — that hostname only resolves
# *inside* the Docker compose network. Bare-metal and Docker both reach
# the same database this way (see docker-compose.yml's mysql: ports:),
# since mysql's 3306 is published to the host. bootstrap/app.php et al.
# never know or care which one actually started the container.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=signage
DB_USERNAME=signage
DB_PASSWORD=signage

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
# 6380, not Redis's default 6379: avoids clashing with a machine-local
# Redis some setups already run for other purposes (e.g. Herd). Must
# match docker-compose.yml's redis: ports: mapping.
REDIS_PORT=6380

# Must match backend/.env.docker's values exactly, not be freshly
# generated here: Reverb itself only ever runs as the Docker `reverb`
# container (there's no native equivalent) — a bare-metal `web` process
# talks to that same, single Reverb instance via the shared Redis above,
# so its app key/secret have to agree with what Reverb was actually
# started with, the same way a client and server always have to.
REVERB_APP_ID=signage-poc
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=6001
REVERB_SCHEME=http
REVERB_SCALING_ENABLED=true

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# From a Google Cloud project's OAuth 2.0 Client (APIs & Services >
# Credentials): a "Web application" client with this redirect URI added
# to its allow-list. See README's Google Workspace integration section.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/admin/integrations/google/callback"

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Fixed dev-only bearer token for the MCP server endpoint (routes/ai.php).
# Generate one with: php -r "echo bin2hex(random_bytes(24));"
MCP_DEV_TOKEN=
